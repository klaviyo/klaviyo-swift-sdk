platform :ios, '13.0'
use_frameworks!

sdk_path = '../../..'

target 'CocoapodsExample' do
  pod 'KlaviyoCore', :path => sdk_path
  pod 'KlaviyoSwift', :path => sdk_path
  pod 'KlaviyoForms', :path => sdk_path
  pod 'KlaviyoLocation', :path => sdk_path
end

target 'NotificationServiceExtension' do
  pod 'KlaviyoSwiftExtension', :path => sdk_path
end
